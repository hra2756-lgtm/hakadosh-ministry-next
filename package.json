{
  "name": "hakadosh-ministry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-youtube-key.cjs node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node scripts/with-youtube-key.cjs node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "studio": "npm --prefix studio run dev",
    "studio:build": "npm --prefix studio run build",
    "backup:blog": "node scripts/backup-blog.mjs",
    "test:backup": "node --test scripts/blog-backup.test.mjs",
    "test:blog": "node --test scripts/blog.test.mjs scripts/blog-likes.test.mjs"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.1.6"
  }
}
